---
interface Props {
  title: string;
  subtitle: string;
  cta: string;
}
const { title, subtitle, cta } = Astro.props;
---
<section class="hero">
  <h1>{title}</h1>
  <p class="subtitle">{subtitle}</p>
  <div class="cta-group">
    <a href="/quickstart/" class="btn primary">{cta}</a>
  </div>
</section>

<style>
  .hero { text-align: center; padding: 80px 0 48px; }
  .hero h1 { font-size: 2.5rem; line-height: 1.3; max-width: 900px; margin: 0 auto 16px; }
  .subtitle { font-size: 1.15rem; color: var(--sl-color-gray-3); max-width: 700px; margin: 0 auto 32px; }
  .cta-group { display: flex; gap: 16px; justify-content: center; }
  .btn { padding: 12px 28px; border-radius: 8px; text-decoration: none; font-weight: 600; }
  .btn.primary { background: var(--sl-color-accent); color: #fff; }
</style>
