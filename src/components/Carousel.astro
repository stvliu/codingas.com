---
import { Image } from 'astro:assets';

interface Props { title: string; image: ImageMetadata; alt: string; }
const { title, image, alt } = Astro.props;
---
<section class="carousel">
  <h2>{title}</h2>
  <div class="frame">
    <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 848px) 100vw, 800px" />
  </div>
</section>

<style>
  .carousel { padding: 48px 0; text-align: center; }
  .frame { margin: 24px auto 0; max-width: 800px; border-radius: 12px; overflow: hidden; border: 1px solid var(--sl-color-gray-6); }
  .frame :global(img) { display: block; width: 100%; height: auto; }
</style>
