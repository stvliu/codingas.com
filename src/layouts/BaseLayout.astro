---
// 营销页基础布局（首页/对比页/联系页共用）。
// 整站统一 Starlight 主题：加载 Starlight 主题变量（starlight-theme.css），共用 --sl-color-* 体系与暗色模式，
// 与文档页（docs.astro.build 风格）视觉一致。Header 的 GitHub 连接与主题切换复刻 Starlight 的
// SocialIcons 与 Select（ThemeSelect）组件，风格与交互与文档频道完全一致，共用 localStorage.starlight-theme。
import '../styles/starlight-theme.css';
import { navigation } from '../data/navigation';
import '../styles/global.scss';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

// 当前路径判断：/en/ 前缀使用英文 label，与文档站 Header 逻辑一致。
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en/');
const year = new Date().getFullYear();
const githubUrl = 'https://github.com/stvliu/llm-gateway';
const themeLabels = isEn
  ? { dark: 'Dark', light: 'Light', auto: 'Auto', toggle: 'Toggle theme' }
  : { dark: '暗色', light: '亮色', auto: '跟随系统', toggle: '切换主题' };
---
<!doctype html>
<html lang={isEn ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // 主题初始化（防 FOUC），与 Starlight ThemeProvider 一致。
      // localStorage 存 'light'/'dark'，空串或 null 为 auto（用系统偏好）。
      (function () {
        var stored = localStorage.getItem('starlight-theme');
        var theme =
          stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a href="/" class="site-title" translate="no">codingas.com</a>
        <nav class="marketing-nav" aria-label={isEn ? 'Main navigation' : '主导航'}>
          {
            navigation.map((item) => (
              <a
                href={item.href}
                class="nav-item"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {isEn ? item.enLabel : item.label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          {/* GitHub 连接：复刻 Starlight SocialIcons 风格（含分隔线） */}
          <div class="social-icons">
            <a href={githubUrl} rel="me" class="social-icon" aria-label="GitHub">
              <span class="sr-only">GitHub</span>
              <svg viewBox="0 0 16 16" width="1rem" height="1rem" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
              </svg>
            </a>
          </div>
          {/* 主题切换：复刻 Starlight Select（ThemeSelect）结构 */}
          <label class="theme-select" style="--sl-select-width: 6.25em" data-theme="auto">
            <span class="sr-only">{themeLabels.toggle}</span>
            <span class="icon label-icon" aria-hidden="true">
              <svg class="icon-light" viewBox="0 0 24 24" width="0.875rem" height="0.875rem" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
              </svg>
              <svg class="icon-dark" viewBox="0 0 24 24" width="0.875rem" height="0.875rem" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
              </svg>
              <svg class="icon-auto" viewBox="0 0 24 24" width="0.875rem" height="0.875rem" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="12" rx="1" />
                <path d="M2 20h20" />
              </svg>
            </span>
            <select autocomplete="off">
              <option value="dark">{themeLabels.dark}</option>
              <option value="light">{themeLabels.light}</option>
              <option value="auto" selected>{themeLabels.auto}</option>
            </select>
            <svg class="icon caret" viewBox="0 0 24 24" width="1.25rem" height="1.25rem" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </label>
        </div>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <span class="copyright">© {year} codingas.com</span>
        <span class="links">
          <a href={githubUrl}>GitHub</a>
          <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">粤ICP备2023085104号-1</a>
        </span>
      </div>
    </footer>
    <script is:inline>
      // 主题切换（select change），与 Starlight ThemeSelect.onThemeChange 完全一致。
      (function () {
        var storageKey = 'starlight-theme';
        var getPreferred = function () {
          return matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        };
        var parseTheme = function (t) {
          return t === 'auto' || t === 'dark' || t === 'light' ? t : 'auto';
        };
        var loadTheme = function () {
          return parseTheme(localStorage.getItem(storageKey));
        };
        var applyTheme = function (theme) {
          document.documentElement.dataset.theme = theme === 'auto' ? getPreferred() : theme;
        };
        var storeTheme = function (theme) {
          localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
        };
        // 更新 select 值与左侧图标（对应 Starlight updatePickers）
        var updatePicker = function (theme) {
          var label = document.querySelector('.theme-select');
          if (label) label.dataset.theme = theme;
          var sel = label && label.querySelector('select');
          if (sel) sel.value = theme;
        };
        // 系统配色变化时，auto 态自动跟随
        matchMedia('(prefers-color-scheme: light)').addEventListener('change', function () {
          if (loadTheme() === 'auto') applyTheme('auto');
        });
        // select change 切换主题
        var sel = document.querySelector('.theme-select select');
        if (sel) {
          sel.addEventListener('change', function (e) {
            var theme = parseTheme(e.currentTarget.value);
            applyTheme(theme);
            storeTheme(theme);
            updatePicker(theme);
          });
        }
        // 初始化 select 值与图标
        updatePicker(loadTheme());
      })();
    </script>
  </body>
</html>

<style is:global>
  /* 营销页基础样式（is:global 仅在 BaseLayout 渲染时输出，用 Starlight 主题变量）。 */
  body {
    margin: 0;
    font-family: var(--sl-font-system);
    color: var(--sl-color-text);
    background-color: var(--sl-color-bg);
    line-height: var(--sl-line-height);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .site-header {
    background: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    position: sticky;
    top: 0;
    z-index: var(--sl-z-index-navbar);
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--sl-nav-height);
  }
  .site-title {
    font-size: var(--sl-text-h4);
    font-weight: 700;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .marketing-nav {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .nav-item {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-item:hover {
    color: var(--sl-color-text-accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  /* GitHub 连接：复刻 Starlight SocialIcons.astro 样式（含分隔线） */
  .social-icons {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
  .social-icon {
    display: inline-flex;
    align-items: center;
    color: var(--sl-color-text-accent);
    padding: 0.5em;
    margin: -0.5em;
  }
  .social-icon:hover {
    color: var(--sl-color-white);
  }
  /* 主题切换：复刻 Starlight Select.astro 样式 */
  .theme-select {
    --sl-label-icon-size: 0.875rem;
    --sl-caret-size: 1.25rem;
    --sl-inline-padding: 0.5rem;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--sl-color-gray-2);
  }
  .theme-select:hover {
    color: var(--sl-color-white);
  }
  .theme-select .icon {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .theme-select .label-icon {
    font-size: var(--sl-label-icon-size);
    inset-inline-start: 0;
    display: inline-flex;
  }
  .theme-select .label-icon svg {
    display: none;
  }
  .theme-select[data-theme='light'] .icon-light,
  .theme-select[data-theme='dark'] .icon-dark,
  .theme-select[data-theme='auto'] .icon-auto {
    display: block;
  }
  .theme-select .caret {
    font-size: var(--sl-caret-size);
    inset-inline-end: 0;
  }
  .theme-select select {
    border: 0;
    padding-block: 0.625rem;
    padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
      calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
    margin-inline: calc(var(--sl-inline-padding) * -1);
    width: calc(var(--sl-select-width) + var(--sl-inline-padding) * 2);
    background-color: transparent;
    text-overflow: ellipsis;
    color: inherit;
    cursor: pointer;
    appearance: none;
    font-size: var(--sl-text-sm);
  }
  .theme-select option {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-1);
  }
  .site-footer {
    border-top: 1px solid var(--sl-color-hairline-shade);
    margin-top: 4rem;
    padding: 1.5rem 0;
  }
  .site-footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .links {
    display: flex;
    gap: 1.25rem;
  }
  .links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
